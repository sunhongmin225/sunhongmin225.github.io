---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations, getSlugFromId, getLangFromId } from '../i18n/utils';
import { getReadingTime } from '../utils/readingTime';

interface Props {
	currentSlug: string;
	currentTags: string[];
	lang: Lang;
	allPosts: CollectionEntry<'blog'>[];
}

const { currentSlug, currentTags, lang, allPosts } = Astro.props;
const t = useTranslations(lang);

// Filter to same language, exclude current post
const candidates = allPosts
	.filter((p) => getLangFromId(p.id) === lang && getSlugFromId(p.id) !== currentSlug);

// Score by shared tags
const scored = candidates.map((post) => {
	const postTags = post.data.tags || [];
	const sharedCount = postTags.filter((tag: string) => currentTags.includes(tag)).length;
	return { post, score: sharedCount };
});

// Sort by score desc, then date desc
scored.sort((a, b) => {
	if (b.score !== a.score) return b.score - a.score;
	return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
});

const relatedPosts = scored.slice(0, 3).map((s) => s.post);
---

{relatedPosts.length > 0 && (
	<section class="related-posts">
		<div class="related-header">
			<h2>{t('blog.relatedPosts')}</h2>
		</div>
		<div class="related-grid">
			{relatedPosts.map((post) => (
				<PostCard
					title={post.data.title}
					description={post.data.description}
					pubDate={post.data.pubDate}
					heroImage={post.data.heroImage}
					slug={getSlugFromId(post.id)}
					lang={lang}
					tags={post.data.tags}
					readingTime={post.body ? getReadingTime(post.body, lang) : undefined}
					variant="standard"
				/>
			))}
		</div>
	</section>
)}

<style>
	.related-posts {
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 2px solid var(--divider);
	}
	.related-header h2 {
		font-size: 1.5rem;
		margin: 0 0 1.5rem 0;
	}
	.related-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	@media (max-width: 1100px) {
		.related-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 768px) {
		.related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
