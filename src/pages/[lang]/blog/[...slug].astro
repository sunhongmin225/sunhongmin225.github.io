---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { getLangFromId, getSlugFromId } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';
import { getReadingTime } from '../../../utils/readingTime';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { lang: getLangFromId(post.id), slug: getSlugFromId(post.id) },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;

const { lang } = Astro.params as { lang: Lang };
const post = Astro.props;
const { Content, headings } = await render(post);
const readingTime = post.body ? getReadingTime(post.body, lang) : undefined;
const allPosts = await getCollection('blog');
---

<BlogPost
	{...post.data}
	lang={lang}
	headings={headings}
	readingTime={readingTime}
	allPosts={allPosts}
	currentSlug={getSlugFromId(post.id)}
	showToC={true}
	showRelatedPosts={true}
	showBreadcrumb={true}
>
	<Content />
</BlogPost>
