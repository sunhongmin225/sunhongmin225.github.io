---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PostCard from '../../../components/PostCard.astro';
import { languages, type Lang } from '../../../i18n/ui';
import { getLangFromId, getSlugFromId, useTranslations } from '../../../i18n/utils';
import { getReadingTime } from '../../../utils/readingTime';

export function getStaticPaths() {
	return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const posts = (await getCollection('blog'))
	.filter((post) => getLangFromId(post.id) === lang)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const [featuredPost, ...restPosts] = posts;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={t('site.title')} description={t('site.description')} lang={lang} />
		<style>
			main {
				width: var(--listing-width);
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1.5rem;
			}
			.section-header h2 {
				margin: 0;
				font-size: 1.5rem;
			}
			.featured-post {
				margin-bottom: 2rem;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem;
			}
			@media (max-width: 1100px) {
				.posts-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 768px) {
				.posts-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header lang={lang} />
		<main>
			<section>
				<div class="section-header">
					<h2>{t('blog.allPosts')}</h2>
				</div>
				{featuredPost && (
					<div class="featured-post">
						<PostCard
							title={featuredPost.data.title}
							description={featuredPost.data.description}
							pubDate={featuredPost.data.pubDate}
							heroImage={featuredPost.data.heroImage}
							slug={getSlugFromId(featuredPost.id)}
							lang={lang}
							tags={featuredPost.data.tags}
							readingTime={featuredPost.body ? getReadingTime(featuredPost.body, lang) : undefined}
							variant="featured"
						/>
					</div>
				)}
				{restPosts.length > 0 && (
					<div class="posts-grid">
						{restPosts.map((post) => (
							<PostCard
								title={post.data.title}
								description={post.data.description}
								pubDate={post.data.pubDate}
								heroImage={post.data.heroImage}
								slug={getSlugFromId(post.id)}
								lang={lang}
								tags={post.data.tags}
								readingTime={post.body ? getReadingTime(post.body, lang) : undefined}
								variant="standard"
							/>
						))}
					</div>
				)}
			</section>
		</main>
		<Footer lang={lang} />
	</body>
</html>
